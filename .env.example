# ---------------------------------------------------------------------------
# Soulene AI (CAG) - environment configuration
# Copy to .env for local development. On Render, set these as env vars.
# ---------------------------------------------------------------------------

# --- REQUIRED ---
OPENAI_API_KEY=sk-your-key-here

# --- Model ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Safety ---
# Input moderation: OpenAI moderation pass on incoming messages.
ENABLE_INPUT_MODERATION=true
# Optional second LLM reviewer on outgoing replies. The deterministic validator
# (prompt-leak scrub + hard safety block) ALWAYS runs regardless of this flag.
# Leave false in production for lower latency and cost.
ENABLE_OUTPUT_SAFETY_CHECK=false

# --- CAG cache tuning ---
# If the whole knowledge corpus is under this many tokens it is preloaded in full
# (true CAG). Above it, the lexical index narrows the context.
KNOWLEDGE_TOKEN_BUDGET=12000
# Messages kept in the in-memory conversation cache per conversation.
CONTEXT_CACHE_SIZE=100
# Messages actually sent to the model each turn.
PROMPT_WINDOW=20
# Cached factual answers (repeat questions cost zero LLM calls).
RESPONSE_CACHE_ENTRIES=500

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Crisis ---
EMERGENCY_NUMBER=112
# Repeated unsafe attempts in one session before the tone hardens.
STRICT_UNSAFE_THRESHOLD=3

# --- Request security (STRONGLY recommended in production) ---
# Leave API_KEY empty to disable auth (local dev only). When set, every endpoint
# except /health and / requires it via `Authorization: Bearer <key>` or `X-API-Key`.
API_KEY=
# Separate key required to upload/delete knowledge documents. Without this, any
# valid client key could inject content into the CAG knowledge cache.
ADMIN_API_KEY=
# Requests per minute per caller (per worker process). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=0

# --- Ops ---
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
