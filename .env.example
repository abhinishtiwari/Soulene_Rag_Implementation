# ---------------------------------------------------------------------------
# Soulene AI (CAG) - environment configuration
# Copy to .env for local development. On Render, set these as env vars.
# ---------------------------------------------------------------------------

# --- REQUIRED ---
OPENAI_API_KEY=sk-your-key-here

# --- Model ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Safety ---
# Input moderation: OpenAI moderation pass on incoming messages.
ENABLE_INPUT_MODERATION=true
# Structured full-conversation semantic risk assessment before every response.
# Keep enabled in production; deterministic guardrails remain active if it fails.
ENABLE_SEMANTIC_SAFETY=true
# Maximum transcript characters sent to the assessor; older risk is carried in
# the persisted cumulative safety state.
SEMANTIC_SAFETY_MAX_CHARS=40000
# The second-pass editor is enabled by default. If it is unavailable, the
# deterministic therapeutic-harm wall and fail-closed semantic review still run.
ENABLE_OUTPUT_SAFETY_CHECK=true

# --- CAG cache tuning ---
# If the whole knowledge corpus is under this many tokens it is preloaded in full
# (true CAG). Above it, the lexical index narrows the context.
KNOWLEDGE_TOKEN_BUDGET=12000
# Messages kept in the in-memory conversation cache per conversation.
CONTEXT_CACHE_SIZE=100
# Messages actually sent to the model each turn.
PROMPT_WINDOW=20
# Cached factual answers (repeat questions cost zero LLM calls).
RESPONSE_CACHE_ENTRIES=500

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- External model provider privacy ---
# Messages are processed by an external AI provider. Production sets
# REQUIRE_PROVIDER_DISCLOSURE=true and records who confirmed the user-facing
# notice; startup fails without it. Set SEND_CROSS_SESSION_CONTEXT=false to stop
# prior-session background from crossing the provider boundary at all.
REQUIRE_PROVIDER_DISCLOSURE=false
PROVIDER_DISCLOSURE_ATTESTED=
SEND_CROSS_SESSION_CONTEXT=true

# --- At-rest protection ---
# The app cannot verify volume/database/backup encryption, so production sets
# REQUIRE_ENCRYPTED_STORAGE=true and records who verified it. Startup fails if
# the attestation is missing. There is NO application-level field encryption.
REQUIRE_ENCRYPTED_STORAGE=false
STORAGE_ENCRYPTION_ATTESTED=

# --- Retention (days; 0 = never expire that class) ---
# PROPOSED defaults pending sign-off. Retention is OFF by default so enabling
# deletion is an explicit, reviewed decision. Run a sweep manually with:
#   python main.py --retention
RETENTION_ENABLED=false
RETAIN_CONVERSATION_DAYS=365
RETAIN_SUMMARY_DAYS=90
RETAIN_SAFETY_STATE_DAYS=30
RETAIN_MEMORY_DAYS=180
RETAIN_FEEDBACK_DAYS=730
RETENTION_INTERVAL_HOURS=24

# --- Crisis ---
# A number is only spoken to a user when EMERGENCY_LOCALE is also set, declaring
# that a human verified this number for that locale. Leave EMERGENCY_LOCALE empty
# and replies fall back to neutral "your local emergency services" wording.
EMERGENCY_NUMBER=112
EMERGENCY_LOCALE=
# Repeated unsafe attempts in one session before the tone hardens.
STRICT_UNSAFE_THRESHOLD=3

# --- Request security ---
# Local development may leave this false. Production must set it true; startup
# then refuses to run without separate, non-empty client and administrator keys.
REQUIRE_API_AUTH=false
# Every protected endpoint accepts the client key via
# `Authorization: Bearer <key>` or `X-API-Key`.
API_KEY=
# Document upload/delete always requires this separate administrator key.
ADMIN_API_KEY=
# Requests per minute per caller (per worker process). 0 = unlimited.
RATE_LIMIT_PER_MINUTE=0

# --- Ops ---
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- Durable storage (exactly one source of truth) ---
# sqlite is for local/single-host development; mongo is required for horizontally
# shared production deployments. Backend startup fails instead of falling back.
STORAGE_BACKEND=sqlite
MONGO_URI=
DB_NAME=soulene

# Signs the permanent HttpOnly identity cookie. Use at least 32 random characters.
# Required when STORAGE_BACKEND=mongo; never commit the production value.
IDENTITY_SECRET=
SECURE_IDENTITY_COOKIE=false
